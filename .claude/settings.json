{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-commit-message.js\"",
            "timeout": 15,
            "statusMessage": "Checking the commit message"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-dependencies.sh\"",
            "timeout": 15,
            "statusMessage": "Checking package.json dependencies"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-manifest.sh\"",
            "timeout": 60,
            "statusMessage": "Rebuilding gerillass.json"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-docs.sh\"",
            "timeout": 90,
            "statusMessage": "Checking the docs against the repo"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-wiki.sh\"",
            "timeout": 30,
            "statusMessage": "Checking the wiki against the release"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-docs-current.sh\"",
            "timeout": 120,
            "statusMessage": "Checking the docs kept up with the branch"
          }
        ]
      }
    ]
  }
}
