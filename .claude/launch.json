{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "site"
      ],
      "port": 7001
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "site"
      ],
      "port": 4173
    },
    {
      "name": "browser-check",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/browser-check.js",
        "--serve",
        "7002"
      ],
      "port": 7002
    }
  ]
}
