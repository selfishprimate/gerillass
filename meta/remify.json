{
  "name": "remify",
  "summary": "Converts a pixel length to rem, against a 16px root.",
  "arguments": [
    {
      "name": "$value",
      "accepts": [
        "a pixel length"
      ]
    }
  ],
  "examples": [
    ".a { font-size: remify(24px); }"
  ],
  "rejects": [
    ".a { font-size: remify(nonsense); }",
    ".a { font-size: remify(1.5rem); }",
    ".a { font-size: remify(24); }"
  ]
}
