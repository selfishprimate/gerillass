{
  "name": "shorthandProperty",
  "summary": "Expands one to four values into the four-value CSS shorthand order.",
  "arguments": [
    {
      "name": "$value",
      "accepts": [
        "one to four values"
      ]
    }
  ],
  "examples": [
    ".a { margin: shorthandProperty(10px 20px); }"
  ],
  "rejects": [
    ".a { margin: shorthandProperty(1px 2px 3px 4px 5px); }"
  ]
}
