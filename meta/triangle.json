{
  "name": "triangle",
  "summary": "Draws a CSS triangle out of borders, pointing in a given direction.",
  "arguments": [
    {
      "name": "$direction",
      "accepts": [
        "top",
        "top-right",
        "right",
        "bottom-right",
        "bottom",
        "bottom-left",
        "left",
        "top-left",
        "inline-start, inline-end, block-start or block-end, which follow the writing direction"
      ]
    },
    {
      "name": "$color",
      "accepts": [
        "a Sass colour, such as red, #333 or oklch(70% 0.1 200)",
        "currentColor",
        "var(), color-mix() or light-dark(), which CSS resolves"
      ]
    },
    {
      "name": "$size",
      "accepts": [
        "one length, or two lengths as width then height",
        "var(), env() or a calculation in place of any length"
      ]
    }
  ],
  "examples": [
    ".caret { @include triangle(\"bottom\", black, 10px 8px); }",
    ".arrow { @include triangle(\"left\", red); }",
    ".arrow { @include triangle(\"right\", var(--accent), 6px 8px); }",
    ".arrow { @include triangle(\"right\", currentColor); }",
    ".arrow { @include triangle(\"top\", color-mix(in srgb, red 50%, blue)); }",
    ".arrow { @include triangle(\"bottom\", currentColor, var(--caret-w) var(--caret-h)); }",
    ".next { @include triangle(\"inline-end\", currentColor, 8px 12px); }",
    ".sort { @include triangle(\"block-start\", currentColor); }"
  ],
  "rejects": [
    ".caret { @include triangle(sideways); }",
    ".caret { @include triangle(\"top\", notacolor); }",
    ".caret { @include triangle(\"top\", url(a.png)); }",
    ".caret { @include triangle(\"top\", red, nonsense); }"
  ]
}
