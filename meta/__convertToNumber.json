{
  "name": "__convertToNumber",
  "summary": "Parses a string of digits into a number.",
  "arguments": [
    {
      "name": "$value",
      "accepts": [
        "a string containing only digits"
      ]
    }
  ],
  "examples": [
    ".a { z-index: __convertToNumber(\"42\"); }"
  ],
  "rejects": [
    ".a { --x: #{__convertToNumber(42)}; }"
  ]
}
