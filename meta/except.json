{
  "name": "except",
  "summary": "Selects every sibling except the ones named.",
  "arguments": [
    {
      "name": "$params",
      "accepts": [
        "a positive or negative index, a whole number other than 0; a unit or a fraction makes a selector the browser drops, and 0 excludes nothing, so both are refused",
        "first, last, odd or even",
        "a selector such as .foo",
        "several indexes, all of them numbers"
      ]
    }
  ],
  "examples": [
    ".a { @include except(\"first\") { margin: 0; } }",
    ".a { @include except(2) { margin: 0; } }",
    ".a { @include except(1, 3) { margin: 0; } }"
  ],
  "rejects": [
    ".a { @include except(#ff0000) { margin: 0; } }",
    ".a { @include except(10deg) { margin: 0; } }",
    ".a { @include except(-10px) { margin: 0; } }",
    ".a { @include except(1.5) { margin: 0; } }",
    ".a { @include except(0) { margin: 0; } }",
    ".a { @include except(1, 10deg) { margin: 0; } }",
    ".a { @include except(2, \"first\") { margin: 0; } }"
  ]
}
