{
  "name": "only",
  "summary": "Selects only the siblings named.",
  "arguments": [
    {
      "name": "$params",
      "accepts": [
        "a positive or negative index, a whole number other than 0; a unit or a fraction makes a selector the browser drops, and 0 matches nothing, so both are refused",
        "first, last, odd or even",
        "a selector such as .foo",
        "several indexes, all of them numbers"
      ]
    }
  ],
  "examples": [
    ".a { @include only(\"first\") { margin: 0; } }",
    ".a { @include only(-1) { margin: 0; } }",
    ".a { @include only(1, 3) { margin: 0; } }"
  ],
  "rejects": [
    ".a { @include only(#ff0000) { margin: 0; } }",
    ".a { @include only(10deg) { margin: 0; } }",
    ".a { @include only(-10px) { margin: 0; } }",
    ".a { @include only(1.5) { margin: 0; } }",
    ".a { @include only(0) { margin: 0; } }",
    ".a { @include only(1, 10deg) { margin: 0; } }",
    ".a { @include only(2, \"first\") { margin: 0; } }"
  ]
}
