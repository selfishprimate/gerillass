{
  "name": "font-face",
  "summary": "Emits an @font-face rule for one family across several file formats. Must be called at the root.",
  "arguments": [
    {
      "name": "$font-family",
      "accepts": [
        "the family name"
      ]
    },
    {
      "name": "$file-path",
      "accepts": [
        "path to the files, without an extension"
      ]
    },
    {
      "name": "$font-style",
      "accepts": [
        "normal, italic, oblique or auto, or oblique with one or two angles from -90deg to 90deg",
        "a number from 1 to 1000, which is read as the weight"
      ]
    },
    {
      "name": "$font-weight",
      "accepts": [
        "normal, bold, auto, or a number from 1 to 1000",
        "two numbers for a variable font's range, such as 100 900",
        "bolder, lighter and the CSS-wide keywords are refused, because a @font-face rule drops them"
      ]
    },
    {
      "name": "$file-formats",
      "accepts": [
        "any of eot, woff2, woff, ttf, svg",
        "woff2, the default"
      ]
    },
    {
      "name": "$font-display",
      "accepts": [
        "auto, block, swap, fallback or optional",
        "null, the default, to leave font-display out"
      ]
    }
  ],
  "examples": [
    "@include font-face(\"Inter\", \"/fonts/inter\");",
    "@include font-face(\"Inter\", \"/fonts/inter\", italic, 700, woff2 woff);",
    "@include font-face(\"Readex Pro\", \"/fonts/readex\", $font-weight: 160 700, $file-formats: woff2, $font-display: swap);",
    "@include font-face(\"Inter\", \"/fonts/inter\", \"italic\", $font-weight: \"bold\", $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", oblique 10deg 20deg, $font-weight: 450.5, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", auto, \"100 900\", $file-formats: woff2);"
  ],
  "rejects": [
    ".a { @include font-face(\"Inter\", \"/fonts/inter\"); }",
    "@include font-face(42, \"/fonts/x\");",
    "@include font-face(\"Inter\", 42);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: otf);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2 wof);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: null);",
    "@include font-face(\"Inter\", var(--font-path));",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2, $font-display: fast);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2, $font-display: var(--display));",
    "@include font-face(var(--font-family), \"/fonts/inter\", $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", var(--font-style), $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: var(--font-weight), $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: 100 var(--max-weight), $file-formats: woff2);",
    "@include font-face(sans-serif, \"/fonts/inter\", $file-formats: woff2);",
    "@include font-face(inherit, \"/fonts/inter\", $file-formats: woff2);",
    "@include font-face(env(--font-family), \"/fonts/inter\", $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", huge, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", oblique 100deg, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", inherit, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: huge, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: bolder, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: 0, $file-formats: woff2);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $font-weight: 100 200 300, $file-formats: woff2);"
  ],
  "caveats": [
    "`$file-formats` defaults to `woff2`. A project that ships only `.woff` or `.ttf` and passes no formats gets no font, silently, in Chrome, Firefox and Safari. Pass the formats you have files for. Until 4.0.0 the default was `eot woff2 woff ttf svg`, which made webpack, esbuild and Parcel fail on a missing `.eot`.",
    "Must be called at the root of a stylesheet, not inside a selector."
  ]
}
