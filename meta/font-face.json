{
  "name": "font-face",
  "summary": "Emits an @font-face rule for one family across several file formats. Must be called at the root.",
  "arguments": [
    {
      "name": "$font-family",
      "accepts": [
        "the family name"
      ]
    },
    {
      "name": "$file-path",
      "accepts": [
        "path to the files, without an extension"
      ]
    },
    {
      "name": "$font-style",
      "accepts": [
        "normal, italic or oblique, or a weight number"
      ]
    },
    {
      "name": "$font-weight",
      "accepts": [
        "a weight"
      ]
    },
    {
      "name": "$file-formats",
      "accepts": [
        "any of eot, woff2, woff, ttf, svg"
      ]
    },
    {
      "name": "$font-display",
      "accepts": [
        "auto, block, swap, fallback or optional",
        "null, the default, to leave font-display out"
      ]
    }
  ],
  "examples": [
    "@include font-face(\"Inter\", \"/fonts/inter\");",
    "@include font-face(\"Inter\", \"/fonts/inter\", italic, 700, woff2 woff);",
    "@include font-face(\"Readex Pro\", \"/fonts/readex\", $font-weight: 160 700, $file-formats: woff2, $font-display: swap);"
  ],
  "rejects": [
    ".a { @include font-face(\"Inter\", \"/fonts/inter\"); }",
    "@include font-face(42, \"/fonts/x\");",
    "@include font-face(\"Inter\", 42);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: otf);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2 wof);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: null);",
    "@include font-face(\"Inter\", var(--font-path));",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2, $font-display: fast);",
    "@include font-face(\"Inter\", \"/fonts/inter\", $file-formats: woff2, $font-display: var(--display));"
  ]
}
