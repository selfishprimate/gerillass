{
  "name": "__darken",
  "summary": "Mixes a colour towards black by a percentage.",
  "arguments": [
    {
      "name": "$color",
      "accepts": [
        "a colour"
      ]
    },
    {
      "name": "$percentage",
      "accepts": [
        "a percentage"
      ]
    }
  ],
  "examples": [
    ".a { color: __darken(red, 20%); }"
  ],
  "rejects": [
    ".a { color: __darken(notacolor, 20%); }"
  ]
}
