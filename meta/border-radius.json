{
  "name": "border-radius",
  "summary": "Rounds corners, either all of them, one named corner, or all four individually.",
  "arguments": [
    {
      "name": "$args",
      "accepts": [
        "one length for every corner",
        "a corner name plus a length",
        "a logical corner or edge plus a length: start-start, start-end, end-start, end-end, inline-start, inline-end, block-start or block-end",
        "four lengths: top-left, top-right, bottom-right, bottom-left"
      ]
    }
  ],
  "examples": [
    ".a { @include border-radius(8px); }",
    ".a { @include border-radius(\"top\", 8px); }",
    ".a { @include border-radius(1px, 2px, 3px, 4px); }",
    ".tab { @include border-radius(\"inline-start\", 8px); }",
    ".bubble { @include border-radius(\"end-end\", 12px); }"
  ],
  "rejects": [
    ".a { @include border-radius(1px, 2px, 3px); }",
    ".a { @include border-radius(nonsense, 5px); }",
    ".a { @include border-radius(-4px); }",
    ".a { @include border-radius(auto); }",
    ".a { @include border-radius(10deg); }",
    ".a { @include border-radius(1px 2px 3px 4px 5px); }",
    ".a { @include border-radius(\"top\", 1px 2px 3px); }",
    ".a { @include border-radius(1px, 2px, -3px, 4px); }"
  ]
}
