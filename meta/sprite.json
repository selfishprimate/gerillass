{
  "name": "sprite",
  "summary": "Sets up an element as a sprite tile: an image, a background position, or both.",
  "arguments": [
    {
      "name": "$params",
      "accepts": [
        "an image path ending in .png, .jpg or .svg",
        "a background position",
        "both, image first, where the image is one path as a string"
      ]
    }
  ],
  "examples": [
    ".icon { @include sprite(\"/img/sprite.png\"); }",
    ".icon { @include sprite(\"/img/sprite.png\", 0 -40px); }",
    ".icon { @include sprite(0 -40px); }"
  ],
  "rejects": [
    ".icon { @include sprite(\"/img/sprite.txt\"); }",
    ".icon { @include sprite(\"/img/a.png\" \"/img/b.png\", 0 -40px); }",
    ".icon { @include sprite(42, 0 -40px); }",
    ".icon { @include sprite(0 red); }",
    ".icon { @include sprite(\"/img/sprite.png\", 10deg); }",
    ".icon { @include sprite(\"/img/sprite.png\", 1); }",
    ".icon { @include sprite(\"/img/sprite.png\", 10px 20px 30px 40px); }",
    ".icon { @include sprite(\"/img/sprite.png\", auto); }"
  ]
}
