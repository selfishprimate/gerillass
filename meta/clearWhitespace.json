{
  "name": "clearWhitespace",
  "summary": "Removes every space from a string.",
  "arguments": [
    {
      "name": "$string",
      "accepts": [
        "any string"
      ]
    }
  ],
  "examples": [
    ".a { content: clearWhitespace(\"a b c\"); }"
  ],
  "rejects": [
    ".a { --x: #{clearWhitespace(42)}; }"
  ]
}
