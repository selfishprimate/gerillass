exports[`Manifest examples brand-logo: .logo { @include brand-logo(120px, 40px, "/img/logo.svg"); } 1`] = `
".logo {
  display: inline-block;
  position: relative;
  width: 120px;
  height: 40px;
  background-image: url("/img/logo.svg");
  background-position: center;
  background-repeat: no-repeat;
  background-size: 100%;
}
.logo a {
  display: block;
  width: 1px;
  height: 1px;
  overflow: hidden;
  text-indent: 100%;
}
.logo a::after {
  content: "";
  position: absolute;
  pointer-events: auto;
  inset: 0;
  z-index: 1;
}"
`;

