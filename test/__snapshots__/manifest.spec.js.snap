}
.grid > * {
  box-sizing: border-box;
  flex-grow: 0;
  flex-shrink: 0;
  min-inline-size: 0;
  flex-basis: calc(100% / 3);
}
:where(.grid)::before, :where(.grid)::after, :where(.grid) *, :where(.grid) *::before, :where(.grid) *::after {
  box-sizing: border-box;
}"
`;

