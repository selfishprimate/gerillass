exports[`Manifest examples columnizer: .grid { @include columnizer(#{3}, 0); } 1`] = `
".grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0px;
  box-sizing: border-box;
}
.grid > * {
  box-sizing: border-box;
  flex-grow: 0;
  flex-shrink: 0;
  min-inline-size: 0;
  flex-basis: calc((100% - (3 - 1) * 0px) / 3);
}
:where(.grid)::before, :where(.grid)::after, :where(.grid) *, :where(.grid) *::before, :where(.grid) *::after {
  box-sizing: border-box;
}"
`;

