exports[`Manifest examples reveal: .dropdown { @include reveal(popover, 0.5s, right 1.5rem, null, false,  1`] = `
".dropdown {
  opacity: 0;
  translate: 1.5rem 0;
  transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), translate 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), display 0.5s allow-discrete, overlay 0.5s allow-discrete;
}
.dropdown:popover-open {
  opacity: 1;
  translate: 0 0;
}
@starting-style {
  .dropdown:popover-open {
    opacity: 0;
    translate: 1.5rem 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .dropdown {
    transition-duration: 0.01ms;
  }
}"
`;

exports[`Manifest examples reveal: .menu { @include reveal(".is-open", 200ms, right 1rem, null, false); } 1`] = `
".menu {
  opacity: 0;
  translate: 1rem 0;
  transition: opacity 200ms ease, translate 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
}
.menu.is-open {
  opacity: 1;
  translate: 0 0;
}
@starting-style {
  .menu.is-open {
    opacity: 0;
    translate: 1rem 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .menu {
    transition-duration: 0.01ms;
  }
}"
`;

exports[`Manifest examples reveal: .modal { @include reveal(dialog, 0.25s, none, 0.95); } 1`] = `
".modal {
  opacity: 0;
  scale: 0.95;
  transition: opacity 0.25s ease, scale 0.25s ease, display 0.25s allow-discrete, overlay 0.25s allow-discrete;
}
.modal[open] {
  opacity: 1;
  scale: 1;
}
@starting-style {
  .modal[open] {
    opacity: 0;
    scale: 0.95;
  }
}
.modal::backdrop {
  opacity: 0;
  transition: opacity 0.25s ease, display 0.25s allow-discrete, overlay 0.25s allow-discrete;
}
