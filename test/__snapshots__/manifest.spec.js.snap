exports[`Manifest examples reset-css: @include reset-css; 1`] = `
"*,
*::before,
*::after {
  box-sizing: border-box;
}

:where(body, h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd, pre) {
  margin: 0;
}

:where(body) {
  line-height: 1.5;
  -webkit-text-size-adjust: none;
  text-size-adjust: none;
}

:where(h1, h2, h3, h4, h5, h6, button, input, label) {
  line-height: 1.1;
}

:where(ul, ol)[role=list] {
  list-style: none;
  padding: 0;
}

:where(img, picture, video, canvas) {
  display: block;
}

:where(img, picture, video, canvas, svg) {
  max-width: 100%;
}

:where(input, button, textarea, select) {
  font: inherit;
}

:where(p, h1, h2, h3, h4, h5, h6) {
  overflow-wrap: break-word;
}

:where(textarea):not([rows]) {
  min-height: 10em;
}

:where(:target) {
  scroll-margin-block: 5ex;
}

:where(table) {
  border-collapse: collapse;
  border-spacing: 0;
}"
`;

exports[`Manifest examples reset-figure: figure { @include reset-figure; } 1`] = `
"figure {
  margin: 0;
}
figure img {
  display: block;
  max-inline-size: 100%;
}
:where(figure img) {
  height: auto;
}"
`;

