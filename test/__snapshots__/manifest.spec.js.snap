    max-width: calc(768px - 16px * 2);
  }
}
@media (min-width: 992px) {
  .wrap {
    max-width: calc(992px - 16px * 2);
  }
}
@media (min-width: 1200px) {
  .wrap {
    max-width: calc(1200px - 16px * 2);
  }
}
@media (min-width: 1400px) {
  .wrap {
    max-width: calc(1400px - 16px * 2);
  }
}"
`;

